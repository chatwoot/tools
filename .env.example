# Secrets for tool-tester.rb. Copy to .env and fill in the ones you need:
#
#   cp .env.example .env
#
# Names are <TOOLSET>_<SECRET>, upper-cased with - replaced by _.
# Values here are offered as defaults; press Enter at the prompt to keep them.
# Only secrets belong here. Inputs and tool parameters are prompted each run.

# Attio access token (attio)
ATTIO_ACCESS_TOKEN=

# Better Stack API token (better-stack)
BETTER_STACK_API_TOKEN=

# Cal.com API key (cal-com)
CAL_COM_API_KEY=

# Context.dev API key (context-dev)
CONTEXT_DEV_API_KEY=

# OpenStatus API key (openstatus-dev)
OPENSTATUS_DEV_API_KEY=

# Stripe restricted API key (stripe)
STRIPE_API_KEY=
