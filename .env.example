# Secrets for tool-tester.rb. Copy to .env and fill in the ones you need:
#
#   cp .env.example .env
#
# Names are <FOLDER>_<SECRET>, upper-cased with - replaced by _.
# Values here are offered as defaults; press Enter at the prompt to keep them.
# Only secrets belong here. Inputs and tool parameters are prompted each run.

# ActiveCampaign API key (activecampaign)
ACTIVECAMPAIGN_API_KEY=

